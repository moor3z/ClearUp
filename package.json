{
  "name": "clearup-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:preview": "VITE_ROUTING=hash vite build --outDir dist-preview",
    "preview": "vite preview",
    "indexnow": "node scripts/indexnow.mjs",
    "deploy:notify": "npm run build && node scripts/indexnow.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
